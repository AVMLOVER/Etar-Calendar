<?xml version="1.0" encoding="utf-8"?>
<!--
  The calendar's content area, on a phone held sideways.

  This is deliberately the same arrangement as the portrait layout, and it exists only so that a
  phone is laid out from one description in both orientations.

  It used to be a two pane arrangement: a horizontal LinearLayout splitting the width six to four
  between the main pane and the secondary one. The secondary pane is only ever filled on a tablet,
  where the month view shares its screen with the agenda - and it is hidden on a phone, but a hidden
  weighted child still holds its share of the width. The calendar therefore came out at just over
  half the screen with a column of nothing beside it, which is what made the month view on its side
  look like a different, older screen.

  A real tablet is unaffected: layout-sw600dp-w960dp-h527dp-land has its own two pane layout, and
  that is the one a large screen in landscape gets.
-->
<RelativeLayout
    xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="@null">

    <LinearLayout
        android:orientation="vertical"
        android:layout_width="match_parent"
        android:layout_height="match_parent">
        <TextView
            android:id="@+id/home_time"
            android:layout_width="match_parent"
            android:layout_height="16dip"
            android:gravity="center_vertical|right"
            android:paddingRight="8dip"
            android:textSize="12sp"
            android:visibility="gone" />
        <FrameLayout
            android:id="@+id/main_pane"
            android:layout_weight="2"
            android:layout_height="0dip"
            android:layout_width="match_parent" />

        <FrameLayout
            android:id="@+id/secondary_pane"
            android:visibility="gone"
            android:layout_weight="1"
            android:layout_height="0dip"
            android:layout_width="match_parent" />
    </LinearLayout>

    <!-- The views after this are retained to prevent crashes.
        TODO: Remove if the app can handle them not being there. -->
    <View android:id="@+id/mini_month_container"
        android:layout_width="0dip"
        android:layout_height="0dip"
        android:visibility="gone"/>

    <TextView
        android:id="@+id/date_bar"
        android:layout_width="wrap_content"
        android:layout_height="42dip"
        android:gravity="center_vertical"
        android:textSize="24sp"
        android:visibility="gone"/>
    <TextView
        android:id="@+id/week_num"
        android:layout_width="wrap_content"
        android:layout_height="42dip"
        android:gravity="center_vertical"
        android:paddingStart="8dip"
        android:textSize="18sp"
        android:visibility="gone"/>

    <FrameLayout
        android:id="@+id/mini_month"
        android:layout_width="0dip"
        android:layout_height="0dip"
        android:visibility="gone"/>

    <FrameLayout
        android:id="@+id/calendar_list"
        android:layout_width="0dip"
        android:layout_height="0dip"
        android:visibility="gone"/>
</RelativeLayout>
