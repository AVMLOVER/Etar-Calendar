<?xml version="1.0" encoding="utf-8"?>
<androidx.drawerlayout.widget.DrawerLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    xmlns:tools="http://schemas.android.com/tools"
    android:id="@+id/drawer_layout"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    tools:context="com.android.calendar.AllInOneActivity">

    <androidx.coordinatorlayout.widget.CoordinatorLayout
        android:id="@+id/coordinator_layout"
        android:layout_width="match_parent"
        android:layout_height="match_parent">

        <include
            android:id="@+id/include"
            layout="@layout/all_in_one"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            app:layout_behavior="@string/appbar_scrolling_view_behavior" />

        <com.google.android.material.appbar.AppBarLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content">

            <androidx.appcompat.widget.Toolbar
                android:id="@+id/toolbar"
                android:background="?attr/android:windowBackground"
                android:layout_width="match_parent"
                android:layout_height="?attr/actionBarSize"
                android:minHeight="?attr/actionBarSize"
                android:theme="@style/ThemeOverlay.CalendarAppTheme.ActionBar"
                app:contentInsetStart="0dp"
                app:contentInsetStartWithNavigation="0dp"
                app:menu="@menu/all_in_one_title_bar"
                app:navigationIcon="@drawable/ic_menu_navigator"
                app:subtitleTextAppearance="@style/TextAppearance.M3e.ToolbarSubtitle"
                app:titleTextAppearance="@style/TextAppearance.M3e.ToolbarTitle">

                <!--
                  The heading, both lines in one view.

                  The ActionBar's own title and subtitle were used for a while, and the two did not
                  line up: they are separate views, each inset by the toolbar's start inset, and the
                  first line sits a little further right than the second because a view's edge is the
                  start of its line box rather than the start of its first glyph - the gap is the font's
                  left side bearing, and it is not the same for the two sizes. One view holding both
                  lines gives them one origin and they cannot disagree.

                  Two lines rather than one joined line: the second line is a smaller span, and a size
                  span and auto-sizing do not work together - auto-sizing measures the whole text and
                  picks one size for all of it. With the lines apart, the size span applies and the
                  subtitle still fits, which is what the Chinese date needs.
                -->
                <TextView
                    android:id="@+id/m3e_title_text"
                    android:layout_width="wrap_content"
                    android:maxWidth="280dp"
                    android:layout_height="wrap_content"
                    android:ellipsize="end"
                    android:maxLines="2"
                    android:textAppearance="@style/TextAppearance.M3e.ToolbarHeading"
                    android:textColor="?attr/colorOnSurface" />

            </androidx.appcompat.widget.Toolbar>
        </com.google.android.material.appbar.AppBarLayout>

        <com.google.android.material.floatingactionbutton.FloatingActionButton
            android:id="@+id/floating_action_button"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_gravity="bottom|end"
            android:layout_margin="@dimen/fab_margin"
            android:backgroundTint="@color/colorAccent"
            android:contentDescription="@string/event_create"
            android:src="@drawable/ic_add_event"
            app:borderWidth="0dp"
            app:layout_anchorGravity="bottom|right|end"
            app:tint="@android:color/white" />

    </androidx.coordinatorlayout.widget.CoordinatorLayout>

    <com.google.android.material.navigation.NavigationView
        android:id="@+id/navigation_view"
        android:layout_width="wrap_content"
        android:layout_height="match_parent"
        android:layout_gravity="start"
        android:fitsSystemWindows="true"
        app:itemBackground="@drawable/m3e_drawer_item_background"
        app:menu="@menu/calendar_view" />
</androidx.drawerlayout.widget.DrawerLayout>
