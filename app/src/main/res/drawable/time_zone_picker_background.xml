<?xml version="1.0" encoding="utf-8"?>
<!--
  Background for the time zone picker dialog.

  Same fix as the recurrence picker: the dialog painted ?attr/colorSurfaceContainer straight onto
  its root layout, which gave it square corners. TimeZonePickerDialog also clears the window
  background so nothing square shows behind it.
-->
<shape xmlns:android="http://schemas.android.com/apk/res/android"
    android:shape="rectangle">
    <solid android:color="?attr/colorSurfaceContainer" />
    <corners android:radius="28dp" />
</shape>