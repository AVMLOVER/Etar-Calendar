<?xml version="1.0" encoding="utf-8"?>
<!--
  Overflow (three vertical dots) icon, in the theme's control colour.

  It used to be a fixed black, which the Compose bars recolour themselves but the classic title bar
  does not: set as that bar's overflow icon it drew black dots on the dark bar. Following the theme
  attribute makes it black on a light bar and white on a dark one; the Compose usages set their own
  colour and are unaffected.
-->
<vector xmlns:android="http://schemas.android.com/apk/res/android"
    android:width="24dp"
    android:height="24dp"
    android:viewportWidth="24"
    android:viewportHeight="24">
    <path
        android:fillColor="?attr/colorControlNormal"
        android:pathData="M12,5 m-1.8,0 a1.8,1.8 0 1,0 3.6,0 a1.8,1.8 0 1,0 -3.6,0" />
    <path
        android:fillColor="?attr/colorControlNormal"
        android:pathData="M12,12 m-1.8,0 a1.8,1.8 0 1,0 3.6,0 a1.8,1.8 0 1,0 -3.6,0" />
    <path
        android:fillColor="?attr/colorControlNormal"
        android:pathData="M12,19 m-1.8,0 a1.8,1.8 0 1,0 3.6,0 a1.8,1.8 0 1,0 -3.6,0" />
