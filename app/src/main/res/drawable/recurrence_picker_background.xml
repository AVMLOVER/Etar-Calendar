<?xml version="1.0" encoding="utf-8"?>
<!--
  Background for the recurrence picker dialog.

  The dialog used to paint ?attr/colorSurfaceContainer straight onto its root layout, which gave
  it square corners. A shape drawable with the same colour and rounded corners is the whole fix;
  RecurrencePickerDialog also clears the window background so nothing square shows behind it.
-->
<shape xmlns:android="http://schemas.android.com/apk/res/android"
    android:shape="rectangle">
    <solid android:color="?attr/colorSurfaceContainer" />
    <corners android:radius="28dp" />
</shape>
