<?xml version="1.0" encoding="utf-8"?>
<!--
  A month arrow: the chevron that pages the month widget.

  Tinted from a colour resource rather than a theme role, because the launcher inflates widget
  drawables without the app's theme - an `?attr` tint resolves to nothing there and the icon comes
  out invisible.
-->
<vector xmlns:android="http://schemas.android.com/apk/res/android"
    android:width="24dp"
    android:height="24dp"
    android:viewportWidth="24"
    android:viewportHeight="24"
    android:tint="@color/widget_on_surface">
    <path
        android:fillColor="@android:color/white"
        android:pathData="M15.4,7.4L14,6l-6,6 6,6 1.4,-1.4 -4.6,-4.6z" />
</vector>
