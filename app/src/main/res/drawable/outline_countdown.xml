<?xml version="1.0" encoding="utf-8"?>
<!--
Countdown ("倒数日") icon: a house on the same 24dp grid and 1.6dp stroke as the date calculator, so
the two entries in the drawer read as a pair.
-->
<vector xmlns:android="http://schemas.android.com/apk/res/android"
    android:width="24dp"
    android:height="24dp"
    android:viewportWidth="24"
    android:viewportHeight="24">

    <!-- roof -->
    <path
        android:pathData="M2.5,11.5 L12,3.5 L21.5,11.5"
        android:strokeColor="#FF000000"
        android:strokeWidth="1.6"
        android:strokeLineCap="round"
        android:strokeLineJoin="round"
        android:fillColor="#00000000" />

    <!-- walls -->
    <path
        android:pathData="M5,10.2 V20 a0.8,0.8 0 0 0 0.8,0.8 h12.4 a0.8,0.8 0 0 0 0.8,-0.8 V10.2"
        android:strokeColor="#FF000000"
        android:strokeWidth="1.6"
        android:strokeLineCap="round"
        android:strokeLineJoin="round"
        android:fillColor="#00000000" />

    <!-- door -->
    <path
        android:pathData="M10.2,20.8 v-4.6 a1.8,1.8 0 0 1 3.6,0 v4.6"
        android:strokeColor="#FF000000"
        android:strokeWidth="1.4"
        android:strokeLineCap="round"
        android:strokeLineJoin="round"
        android:fillColor="#00000000" />
</vector>
