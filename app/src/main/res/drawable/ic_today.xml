<?xml version="1.0" encoding="utf-8"?>
<!--
  Today icon for the Compose top bar.

  Deliberately a plain <vector> with no android:tint: Compose's painterResource only accepts
  vectors and raster assets, and it parses the XML itself rather than going through the View
  drawable path. The app's today_icon is a <layer-list>, which painterResource rejects with
  "Only VectorDrawables and rasterized asset types are supported". Icon() tints this one from the
  content colour instead.
-->
<vector xmlns:android="http://schemas.android.com/apk/res/android"
    android:width="24dp"
    android:height="24dp"
    android:viewportWidth="24"
    android:viewportHeight="24">
    <path
        android:fillColor="#FF000000"
        android:pathData="M19,3h-1V1h-2v2H8V1H6v2H5C3.89,3 3,3.9 3,5v14c0,1.1 0.89,2 2,2h14c1.1,0 2,-0.9 2,-2V5C21,3.9 20.1,3 19,3zM19,19H5V8h14V19z" />
    <path
        android:fillColor="#FF000000"
        android:pathData="M7,10h5v5H7z" />
</vector>
